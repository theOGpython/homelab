# Copy to .env and fill in:   cp .env.example .env
# .env is gitignored. NEVER commit real keys or passwords.

# --- General -----------------------------------------------------------------
TZ=Africa/Lagos
PUID=1000
PGID=1000

# GID of the "render" group inside the docker LXC.
# Check with:  getent group render | cut -d: -f3
RENDER_GID=993

CONFIG_ROOT=/opt/stacks
DATA_ROOT=/srv/data
LAN_SUBNET=192.168.3.0/24

# --- Tailscale ---------------------------------------------------------------
# Admin console -> Settings -> Keys -> Generate auth key
# Reusable: ON   Ephemeral: OFF
TS_AUTHKEY=tskey-auth-REPLACE_ME
TS_EXTRA_ARGS=

# --- VPN (gluetun) -----------------------------------------------------------
# Provider-specific setup: https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=surfshark
VPN_TYPE=wireguard

# WireGuard (preferred: faster, lighter)
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# OpenVPN (only if VPN_TYPE=openvpn)
OPENVPN_USER=
OPENVPN_PASSWORD=

SERVER_COUNTRIES=Netherlands
