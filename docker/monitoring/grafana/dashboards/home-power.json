{
  "uid": "home-power",
  "title": "Home Power (Felicity inverter)",
  "tags": [
    "homelab",
    "power"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
